# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults match backend/docker-compose.yml)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=eeqs
DB_USER=eeqs
DB_PASSWORD=eeqs_dev_password
DB_HOST=localhost
DB_PORT=5432
# 临时回退 SQLite：DB_ENGINE=django.db.backends.sqlite3（DB_NAME 留空则用 backend/db.sqlite3）

# Hydrology prediction pipeline (file-exchange via Docker container)
HYDROLOGY_MODEL_IMAGE=eeqs-prediction-model:latest
# HYDROLOGY_DOCKER_BIN=       # 留空自动探测；Docker Desktop 默认 C:\Program Files\Docker\Docker\resources\bin\docker.exe
# HYDROLOGY_IO_DIR=           # 默认 backend/prediction_io
HYDROLOGY_INPUT_DAYS=30
HYDROLOGY_DOCKER_TIMEOUT_SECONDS=300
HYDROLOGY_DEFAULT_MODEL_NAME=mock-scale-7day
HYDROLOGY_DEFAULT_MODEL_VERSION=v1

# Celery / Redis (optional — leave empty to disable)
CELERY_BROKER_URL=

# ---- AI assistant ----
# OpenAI 兼容协议的 LLM 服务（默认 DeepSeek；key 只写在本文件，绝不提交）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# LLM_TIMEOUT_SECONDS=60
# AI_SQL_MAX_ROWS=50
# AI_SQL_TIMEOUT_SECONDS=10
# EXTRAPOLATION_MIN_CONFIDENCE=0.6
# BGE_M3_MODEL_PATH=BAAI/bge-m3
# RAG_TOP_K=5
