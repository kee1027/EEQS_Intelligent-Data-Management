# Root-level gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env

# Python
__pycache__/
*.pyc

# Frontend (placeholder)
frontend/node_modules/
frontend/dist/
frontend/.env.local

# Frontend logs & build stats
frontend/*.log
frontend/stats.json
frontend/.env.development
frontend/.env.production

# Local notes & learning materials (not part of the product)
*教程*/
*指南*/
*笔记*/
*tutorial*/
*tutorials*/
*guide*/
*notes*/
docs-local/

# 本地镜像仓库与数据文件（不入库）
eeqs-mirror/
import_data/
*.dat
*.dat.backup
